# Copy to .env and fill in. Do not commit .env.

# Required for the OpenRouter API path (behavioral evaluation, LLM judge, CoT generation).
OPENROUTER_API_KEY=your-openrouter-key

# Optional: direct OpenAI access for the LLM judge (alternative to OpenRouter).
OPENAI_API_KEY=your-openai-key

# Required only for local inference on gated Hugging Face models (e.g. Llama).
HF_TOKEN=your-huggingface-token
